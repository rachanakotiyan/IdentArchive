# Server Configuration
PORT=3000
NODE_ENV=development
ENVIRONMENT=development

# Security & CORS Settings
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change_me_to_a_secure_random_key_min_32_characters
JWT_EXPIRES_IN=1d

# Database Connection (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=identarchive_app
DB_PASSWORD=your_secure_db_password
DB_NAME=identarchive

# Database Migration User (DDL / schema migrations)
DB_MIGRATE_USER=identarchive_migrate
DB_MIGRATE_PASSWORD=

# Database Application User (alias for DB_USER & DB_PASSWORD)
DB_APP_USER=identarchive_app
DB_APP_PASSWORD=
